root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_style = space
indent_size = 4
max_line_length = 120

# ──────────────────────────────────────────────────────────────────────────────
# ktlint overrides
# ──────────────────────────────────────────────────────────────────────────────

# Composable functions use PascalCase — suppress the standard naming rule for them.
ktlint_function_naming_ignore_when_annotated_with = Composable

# ViewModels use private `_foo` backing properties (Channel/MutableStateFlow) folded into a
# combined public UI state via combine()/stateIn() rather than exposed 1:1 as `foo`/`_foo`
# pairs — this rule doesn't recognize that pattern and flags every one of them as a false
# positive.
ktlint_standard_backing-property-naming = disabled

# ──────────────────────────────────────────────────────────────────────────────
# io.nlopez.compose.rules configuration
# ──────────────────────────────────────────────────────────────────────────────

# Only enforce modifier visibility checks on public composables.
compose_check_modifiers_for_visibility = only_public

[app/src/androidTest/**/*.kt]
# UI tests deliberately wildcard-import androidx.compose.ui.test.* (and org.junit.Assert.*)
# to get all assertion/finder extensions without an unwieldy explicit import list.
ktlint_standard_no-wildcard-imports = disabled
